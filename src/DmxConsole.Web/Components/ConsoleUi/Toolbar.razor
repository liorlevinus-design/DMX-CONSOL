@implements IDisposable
@inject MainViewModel Vm

<div class="toolbar">
    <div class="group">
        <button class="btn" disabled="@Vm.IsEngineRunning" @onclick="() => Vm.StartEngineCommand.Execute(null)">▶ Start Engine</button>
        <button class="btn" disabled="@(!Vm.IsEngineRunning)" @onclick="() => Vm.StopEngineCommand.Execute(null)">■ Stop Engine</button>
        <button class="btn" @onclick="() => Vm.ClearProgrammerCommand.Execute(null)">Clear Programmer</button>
    </div>

    <div class="group">
        <label><input type="checkbox" @bind="Vm.ArtNetEnabled" /> Art-Net</label>
        <input type="text" @bind="Vm.ArtNetTargetIp" style="width:120px" />
        <button class="btn" @onclick="() => Vm.ApplyArtNetTargetCommand.Execute(null)">Apply</button>
    </div>

    <div class="group">
        <label><input type="checkbox" @bind="Vm.SacnEnabled" /> sACN / E1.31</label>
    </div>

    <div class="group">
        <label><input type="checkbox" @bind="Vm.UsbEnabled" /> USB-DMX</label>
        <select @bind="Vm.UsbMode" style="min-height:40px">
            @foreach (var mode in Vm.UsbModeOptions)
            {
                <option value="@mode">@mode</option>
            }
        </select>
        <select @bind="Vm.SelectedComPort" style="min-height:40px">
            @foreach (var port in Vm.AvailableComPorts)
            {
                <option value="@port">@port</option>
            }
        </select>
        <button class="btn btn-icon" title="Refresh COM ports" @onclick="() => Vm.RefreshComPortsCommand.Execute(null)">⟳</button>
        <label>Uni:</label>
        <input type="number" @bind="Vm.UsbUniverseId" style="width:60px" />
        <button class="btn" @onclick="() => Vm.ApplyUsbTargetCommand.Execute(null)">Apply</button>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.PropertyChanged += OnVmChanged;

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Vm.PropertyChanged -= OnVmChanged;
}
