@using DmxConsole.Core.Engine
@using DmxConsole.Application.Live
@implements IDisposable
@inject MainViewModel Vm

@*
    OPERATOR_UX_ROADMAP.md §5: Programmer is de-emphasized as a primary workflow - LIVE is - but
    this panel remains a secondary Editor inspector (its own filter defaults to Editor Only, see
    OnInitialized) for diagnosing exactly what the Programmer currently holds. Uses the SAME
    LiveFilter/LiveChannelState model as Channels/Fixtures (DmxConsole.Application.Live) - no
    parallel business logic, per the roadmap's explicit "don't duplicate business logic" rule.
*@

<div class="channels-view">
    <div class="panel selection-bar" style="flex:none">
        <div class="selection-row">
            <strong style="margin-right:4px">Programmer:</strong>
            <button class="btn" @onclick="() => Prog.ReleaseCommand.Execute(null)">Release</button>
            <button class="btn" @onclick="() => Prog.ClearIntensityCommand.Execute(null)">Clear Intensity</button>
            <button class="btn" @onclick="() => Prog.ClearPositionCommand.Execute(null)">Clear Position</button>
            <button class="btn" @onclick="() => Prog.ClearColorCommand.Execute(null)">Clear Color</button>
            <button class="btn" @onclick="() => Prog.ClearBeamCommand.Execute(null)">Clear Beam</button>
            <button class="btn" @onclick="() => Prog.KnockoutCommand.Execute(null)">Knockout</button>
            <button class="btn" @onclick="() => Prog.RestoreCommand.Execute(null)">Restore</button>
        </div>
        <div class="selection-row">
            <label>Intensity ±</label>
            <input type="number" min="1" max="100" @bind="Prog.AdjustPercent" style="width:60px" />
            <label style="min-width:auto">%</label>
            <button class="btn" @onclick="() => Prog.LowerIntensityCommand.Execute(null)">− Lower</button>
            <button class="btn" @onclick="() => Prog.RaiseIntensityCommand.Execute(null)">+ Raise</button>
            <span class="selection-summary">@Prog.StatusMessage</span>
        </div>
    </div>

    <div class="channels-view-header">
        <span class="channels-view-title">Editor Inspector</span>
        <select class="pane-add-view" @bind="FilterValue">
            <option value="All">All</option>
            <option value="EditorOnly">Editor Only</option>
            <option value="Patched">Patched</option>
            <option value="UsedInShow">Used in Show</option>
            <option value="LiveOnStage">Live on Stage</option>
            <option value="Selected">Selected</option>
        </select>
        <span class="channels-view-count">@FilteredRows().Count() shown</span>
    </div>

    <div class="channels-table-scroll">
        <table class="data-list channels-table">
            <thead>
                <tr>
                    <th>CH</th>
                    <th>Fixture</th>
                    <th>Attribute</th>
                    <th>Effective Live</th>
                    <th>Editor / Pending</th>
                    <th>Provenance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (fader, state) in FilteredRows())
                {
                    var category = ProvenanceClassifier.Classify(state.Owner);
                    int levelPercent = Percent(state.EffectiveValue);
                    bool pending = state.HasEditorValue && !state.EditorValueIsLive;

                    <tr class="channels-row @(state.Owner is not null ? "active" : "") @(state.HasEditorValue ? "programmer" : "") @(pending ? "pending" : "")">
                        <td class="ch-cell">@($"{fader.Fixture.Number}.{OrdinalWithin(fader)}")</td>
                        <td>@fader.FixtureName</td>
                        <td>@fader.ChannelTypeName</td>
                        <td class="level-cell">
                            <div class="level-bar"><div class="level-bar-fill" style="width:@(levelPercent)%"></div></div>
                            <span>@levelPercent%</span>
                        </td>
                        <td class="@(state.HasEditorValue ? "prog-captured" : "prog-none")">
                            @if (state.HasEditorValue)
                            {
                                <span>@Percent(state.EditorValue!.Value)%</span>
                                <span class="programmer-state @(pending ? "state-pending" : "state-live")">@(pending ? "PENDING" : "LIVE")</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="source-cell @ProvenanceClassifier.CssClass(category)">@DescribeOwner(state.Owner)</td>
                    </tr>
                }
                @if (!FilteredRows().Any())
                {
                    <tr><td colspan="6" class="channels-empty">Nothing matches this filter.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private ProgrammerViewModel Prog => Vm.ProgrammerVm;
    private System.Threading.Timer? _liveTimer;

    private string FilterValue
    {
        get => Prog.LiveFilter.ToString();
        set { if (Enum.TryParse<LiveFilter>(value, out var parsed)) Prog.LiveFilter = parsed; }
    }

    protected override void OnInitialized()
    {
        // The EditorOnly default (per OPERATOR_UX_ROADMAP.md §5, "Editor Only table for
        // diagnostics") lives on ProgrammerViewModel's own field initializer, not here - this
        // method used to force-reset Prog.LiveFilter on every mount, which silently discarded
        // whatever filter the operator had actually chosen every time they switched away from
        // this panel and back. ProgrammerViewModel is a long-lived singleton, so its own default
        // only ever applies once, for real.
        Prog.PropertyChanged += OnChanged;
        Vm.Faders.CollectionChanged += OnChanged;
        // Ownership/stored-value state changes continuously while a Cue fades or an Effect runs -
        // same "poll the engine's live state" approach the Channels/Fixtures Views already use.
        _liveTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 200, 200);
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private IEnumerable<(ChannelFaderViewModel Fader, LiveChannelState State)> FilteredRows()
    {
        var usedInShow = ShowUsageQuery.ReferencedAddresses(Prog.Context);
        foreach (var fader in Vm.Faders)
        {
            bool isSelected = Vm.SelectionVm.Selection.Contains(fader.Fixture);
            var state = LiveChannelState.For(Prog.Context, fader.UniverseId, fader.ChannelIndex, isSelected, usedInShow);
            if (!state.Matches(Prog.LiveFilter)) continue;
            yield return (fader, state);
        }
    }

    private static int Percent(byte value) => (int)Math.Round(value / 255.0 * 100);

    private static int OrdinalWithin(ChannelFaderViewModel fader)
    {
        var channels = fader.Fixture.Mode.Channels;
        for (int i = 0; i < channels.Count; i++)
            if (ReferenceEquals(channels[i], fader.Channel)) return i + 1;
        return 0;
    }

    private string DescribeOwner(OutputOwner? owner)
    {
        if (owner is null) return "—";
        if (owner.Kind == OwnerKind.Executor) return ProvenanceClassifier.DescribeExecutorOwner(owner, Vm.ExecutorVm.Bank);
        return owner.DisplayName;
    }

    public void Dispose()
    {
        Prog.PropertyChanged -= OnChanged;
        Vm.Faders.CollectionChanged -= OnChanged;
        _liveTimer?.Dispose();
    }
}
