@using DmxConsole.Core
@using DmxConsole.Core.Engine
@using DmxConsole.Core.Fixtures
@using DmxConsole.Application.Live
@implements IDisposable
@inject MainViewModel Vm

@*
    OPERATOR_UX_ROADMAP.md §4: Fixtures LIVE - one row per fixture, one column per semantic
    parameter family (Intensity/Position/Color/Beam/Image/Shape - the same Vector-bank grouping
    the Encoder Drawer already uses, EncoderCategory). Built entirely from
    DmxConsole.Application.Live.FixtureLiveState - no parameter/provenance/pending logic lives
    here, only formatting of an already-computed read model, so this view can never disagree with
    Channels LIVE or the Editor Inspector about the same channel. This is a summary + selection
    surface, NOT an editor - the Encoder Drawer remains the primary place to change a value.
*@

<div class="channels-view">
    <div class="channels-view-header">
        <span class="channels-view-title">Fixtures — LIVE</span>
        <select class="pane-add-view channels-filter" @bind="Filter" aria-label="Filter fixtures">
            <option value="All">All</option>
            <option value="EditorOnly">Editor Only</option>
            <option value="Patched">Patched</option>
            <option value="UsedInShow">Used in Show</option>
            <option value="LiveOnStage">Live on Stage</option>
            <option value="Selected">Selected</option>
        </select>
        <span class="channels-view-count">@Vm.SelectionVm.Selection.Items.Count selected</span>
        @if (Vm.SelectionVm.Selection.Items.Count > 0)
        {
            <button class="btn" @onclick="ClearSelection">Clear</button>
        }
    </div>

    <div class="channels-table-scroll">
        <table class="data-list channels-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Intensity</th>
                    <th>Position</th>
                    <th>Color</th>
                    <th>Beam</th>
                    <th>Image</th>
                    <th>Shape</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var state in FilteredRows())
                {
                    <tr class="channels-row @(state.IsSelected ? "selected" : "") @(state.IsLiveOnStage ? "active" : "") @(state.HasEditorValue ? "programmer" : "")" @onclick="() => Toggle(state.Fixture)">
                        <td class="ch-cell">@state.Fixture.Number</td>
                        <td>@state.Fixture.Name</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Intensity))">@FormatIntensity(state.Family(EncoderCategory.Intensity))</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Position))">@FormatPosition(state.Family(EncoderCategory.Position))</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Color))">@FormatColor(state.Family(EncoderCategory.Color))</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Beam))">@FormatChannelList(state.Family(EncoderCategory.Beam))</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Image))">@FormatChannelList(state.Family(EncoderCategory.Image))</td>
                        <td class="@FamilyCellClass(state.Family(EncoderCategory.Shape))">@FormatChannelList(state.Family(EncoderCategory.Shape))</td>
                    </tr>
                }
                @if (Vm.Patch.Fixtures.Count == 0)
                {
                    <tr><td colspan="8" class="channels-empty">No fixtures patched yet.</td></tr>
                }
                else if (!FilteredRows().Any())
                {
                    <tr><td colspan="8" class="channels-empty">Nothing matches this filter.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private System.Threading.Timer? _liveTimer;
    private LiveFilter _filter = LiveFilter.All;

    private string Filter
    {
        get => _filter.ToString();
        set { if (Enum.TryParse<LiveFilter>(value, out var parsed)) _filter = parsed; }
    }

    protected override void OnInitialized()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged += OnChanged;
        Vm.Patch.Fixtures.CollectionChanged += OnChanged;
        _liveTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 200, 200);
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private IEnumerable<FixtureLiveState> FilteredRows()
    {
        var context = Vm.ProgrammerVm.Context;
        var usedInShow = ShowUsageQuery.ReferencedAddresses(context);
        foreach (var fixture in Vm.Patch.Fixtures.OrderBy(f => f.Number))
        {
            bool isSelected = Vm.SelectionVm.Selection.Contains(fixture);
            var state = FixtureLiveState.For(context, fixture, isSelected, usedInShow);
            if (state.Matches(_filter)) yield return state;
        }
    }

    private void Toggle(PatchedFixture fixture)
    {
        Vm.SelectionVm.TapFixtureNumberCommand.Execute(fixture);
        Vm.CommandSurfaceVm.SynchronizeFixtureSelection(Vm.SelectionVm.Selection.Items);
        // Same shared EditorContext path as ChannelsView/Command Surface - a click here is just
        // another way to select, never a parallel selection mechanism.
        Vm.EditorContext.EnterObject(DmxConsole.Web.EditorToolBar.EditorObjectType.Fixture,
            "FIXTURE", fixture, $"Fixture {fixture.Number}");
    }

    private void ClearSelection()
    {
        Vm.SelectionVm.ClearSelectionCommand.Execute(null);
        Vm.CommandSurfaceVm.SynchronizeFixtureSelection(Vm.SelectionVm.Selection.Items);
    }

    // ---------- Pure formatting over the already-computed FixtureFamilyState - no decisions
    // about pending/live/mixed happen here, only turning already-decided facts into text/CSS. ----------

    private static string FamilyCellClass(FixtureFamilyState? family)
    {
        if (family is null || family.Channels.Count == 0) return "source-cell src-none";
        if (family.IsMixedProvenance) return "source-cell family-mixed";
        return "source-cell " + ProvenanceClassifier.CssClass(ProvenanceClassifier.Classify(family.CommonOwner));
    }

    private static int Percent(byte value) => (int)Math.Round(value / 255.0 * 100);

    private static string EditorBadge(LiveChannelState state) => state.HasEditorValue ? $" E{Percent(state.EditorValue!.Value)}%" : "";

    private static string FormatIntensity(FixtureFamilyState? family)
    {
        if (family is null || family.Channels.Count == 0) return "—";
        if (family.IsMixedProvenance) return "MIXED";
        var (_, state) = family.Channels[0];
        return $"{Percent(state.EffectiveValue)}%{EditorBadge(state)}";
    }

    private static string FormatPosition(FixtureFamilyState? family)
    {
        if (family is null) return "—";
        var pan = family.Find(ChannelType.Pan);
        var tilt = family.Find(ChannelType.Tilt);
        if (pan is null && tilt is null) return "—";
        if (family.IsMixedProvenance) return "MIXED";

        string panText = pan is null ? "-" : $"{Percent(pan.Value.EffectiveValue)}%{EditorBadge(pan.Value)}";
        string tiltText = tilt is null ? "-" : $"{Percent(tilt.Value.EffectiveValue)}%{EditorBadge(tilt.Value)}";
        return $"P {panText} / T {tiltText}";
    }

    private static string? ColorSwatchStyle(FixtureFamilyState? family)
    {
        if (family is null) return null;
        var red = family.Find(ChannelType.ColorRed);
        var green = family.Find(ChannelType.ColorGreen);
        var blue = family.Find(ChannelType.ColorBlue);
        if (red is null && green is null && blue is null) return null;

        byte r = red?.EffectiveValue ?? 0;
        byte g = green?.EffectiveValue ?? 0;
        byte b = blue?.EffectiveValue ?? 0;
        return $"background:rgb({r},{g},{b})";
    }

    /// <summary>Color is presented as an RGB swatch when the fixture actually has RGB channels -
    /// MIXED provenance still shows the swatch (each channel's own real value, not invented) but
    /// with a visibly different border so the operator knows the three components aren't all
    /// coming from the same source. A fixture whose Color family has no RGB (e.g. a Color Wheel-
    /// only profile) falls back to the same channel+percent text every other non-RGB family uses -
    /// never hides a real ColorWheel channel just because it isn't RGB.</summary>
    private RenderFragment FormatColor(FixtureFamilyState? family) => @<text>
        @{ var swatchStyle = ColorSwatchStyle(family); }
        @if (swatchStyle is not null)
        {
            <span class="color-swatch @(family!.IsMixedProvenance ? "mixed" : "")" style="@swatchStyle" title="@(family.IsMixedProvenance ? "MIXED source" : "")"></span>
        }
        else
        {
            @FormatChannelList(family)
        }
    </text>;

    private static string FormatChannelList(FixtureFamilyState? family)
    {
        if (family is null || family.Channels.Count == 0) return "—";
        if (family.IsMixedProvenance)
        {
            var (type, _) = family.Channels[0];
            return $"{type} MIXED" + (family.Channels.Count > 1 ? $" (+{family.Channels.Count - 1})" : "");
        }

        var (firstType, firstState) = family.Channels[0];
        string label = $"{firstType} {Percent(firstState.EffectiveValue)}%{EditorBadge(firstState)}";
        return family.Channels.Count > 1 ? $"{label} (+{family.Channels.Count - 1})" : label;
    }

    public void Dispose()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged -= OnChanged;
        Vm.Patch.Fixtures.CollectionChanged -= OnChanged;
        _liveTimer?.Dispose();
    }
}
