@using DmxConsole.Core.Selection
@implements IDisposable
@inject MainViewModel Vm

@*
    UX correction #2: Groups as a first-class View, not something hidden inside SelectionBar's
    save-as-group corner. Shows Number/Name/membership for every saved Group; Apply adds its
    members to the current selection.

    Command Surface key-map completion slice: STORE and UPDATE are central console actions
    (pressed on the fixed Command Surface, routed by the shared EditorContext - see
    CommandSurface.razor's PressStore/PressUpdate) - this screen no longer has its own Store/
    Update buttons. The Number/Name fields below remain: they are the parameter INPUTS the
    central STORE key reads (GroupsViewModel.NewGroupNumber/NewGroupName), not a second
    execution path - pressing the fixed STORE key still calls the exact same
    GroupsViewModel.StoreCommand this screen always used. Rename stays local/contextual per
    that slice's instruction; Delete (Remove) also stays local since it was not asked to move.
*@

<div class="groups-view">
    <div class="channels-view-header">
        <span class="channels-view-title">Groups</span>
        <span class="channels-view-count">@Vm.SelectionVm.Selection.Items.Count selected</span>
    </div>

    <div class="groups-store-row" aria-label="Group name/number fields - press the central STORE/UPDATE keys to act">
        <label>#</label>
        <input type="number" min="1" @bind="Vm.GroupsVm.NewGroupNumber" style="width:60px" placeholder="auto" />
        <label>Name</label>
        <input type="text" @bind="Vm.GroupsVm.NewGroupName" style="flex:1; min-width:80px" placeholder="New group name" />
        <span class="groups-status" title="Select fixtures, set Name/#, then press STORE on the Command Surface">Use STORE/UPDATE on the Command Surface</span>
        @if (!string.IsNullOrEmpty(Vm.GroupsVm.StatusMessage))
        {
            <span class="groups-status">@Vm.GroupsVm.StatusMessage</span>
        }
    </div>

    <div class="groups-pool">
        @foreach (var group in Vm.GroupsVm.Groups.Groups.OrderBy(g => g.Number))
        {
            var selectedCount = group.Fixtures.Count(Vm.SelectionVm.Selection.Contains);
            var fullySelected = group.Fixtures.Count > 0 && selectedCount == group.Fixtures.Count;
            var partlySelected = selectedCount > 0 && !fullySelected;
            <article class="group-tile @(ReferenceEquals(_focusedGroup, group) ? "focused" : "") @(fullySelected ? "selected" : partlySelected ? "partial" : "")"
                     @onclick="() => FocusGroup(group)">
                <button class="group-tile-apply" @onclick="() => ApplyGroup(group)" @onclick:stopPropagation="true"
                        aria-label="Apply group @group.Number">
                    <span class="group-tile-number">@group.Number</span>
                    @if (_renamingGroup == group)
                    {
                        <input class="group-rename-input" @bind="_renameText" @bind:event="oninput"
                               @onkeydown="@(e => OnRenameKeyDown(e, group))" @onclick:stopPropagation="true" />
                    }
                    else
                    {
                        <span class="group-tile-name" @ondblclick="() => StartRename(group)" @ondblclick:stopPropagation="true">@group.Name</span>
                    }
                    <span class="group-tile-members">@MemberSummary(group)</span>
                    <span class="group-tile-state">@(fullySelected ? "Selected" : partlySelected ? $"{selectedCount}/{group.Fixtures.Count} selected" : $"{group.Fixtures.Count} fixtures")</span>
                </button>
                <div class="groups-actions" @onclick:stopPropagation="true">
                    <button class="btn" @onclick="() => StartRename(group)">Rename</button>
                    <button class="btn key-danger" @onclick="() => RemoveGroup(group)">Delete</button>
                </div>
            </article>
        }
        @if (Vm.GroupsVm.Groups.Groups.Count == 0)
        {
            <div class="groups-empty">No groups stored yet. Select fixtures, name the group, then press Store.</div>
        }
    </div>
</div>

@code {
    private FixtureGroup? _renamingGroup;
    private FixtureGroup? _focusedGroup;
    private string _renameText = "";

    protected override void OnInitialized()
    {
        Vm.GroupsVm.PropertyChanged += OnChanged;
        Vm.GroupsVm.Groups.Groups.CollectionChanged += OnChanged;
        Vm.SelectionVm.Selection.Items.CollectionChanged += OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void FocusGroup(FixtureGroup group)
    {
        _focusedGroup = group;
        Vm.EditorContext.EnterObject(DmxConsole.Web.EditorToolBar.EditorObjectType.Group, "GROUP", group, $"Group {group.Number} \"{group.Name}\"");
    }

    private void ApplyGroup(FixtureGroup group)
    {
        _focusedGroup = group;
        Vm.GroupsVm.ApplyCommand.Execute(group);
        Vm.CommandSurfaceVm.SynchronizeFixtureSelection(Vm.SelectionVm.Selection.Items);
        Vm.EditorContext.EnterObject(DmxConsole.Web.EditorToolBar.EditorObjectType.Group,
            "GROUP", group, $"Group {group.Number} \"{group.Name}\"");
    }

    private void RemoveGroup(FixtureGroup group)
    {
        Vm.GroupsVm.RemoveCommand.Execute(group);
        if (ReferenceEquals(_focusedGroup, group)) _focusedGroup = null;
    }

    private static string MemberSummary(FixtureGroup group)
    {
        if (group.Fixtures.Count == 0) return "Empty";
        const int visibleMembers = 8;
        var numbers = group.Fixtures.OrderBy(f => f.Number).Select(f => f.Number).ToList();
        var summary = string.Join(" · ", numbers.Take(visibleMembers));
        return numbers.Count > visibleMembers ? $"{summary}  +{numbers.Count - visibleMembers}" : summary;
    }

    private void StartRename(FixtureGroup group)
    {
        _renamingGroup = group;
        _renameText = group.Name;
    }

    private void OnRenameKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, FixtureGroup group)
    {
        if (e.Key == "Enter")
        {
            Vm.GroupsVm.Rename(group, _renameText);
            _renamingGroup = null;
        }
        else if (e.Key == "Escape")
        {
            _renamingGroup = null;
        }
    }

    public void Dispose()
    {
        Vm.GroupsVm.PropertyChanged -= OnChanged;
        Vm.GroupsVm.Groups.Groups.CollectionChanged -= OnChanged;
        Vm.SelectionVm.Selection.Items.CollectionChanged -= OnChanged;
    }
}
