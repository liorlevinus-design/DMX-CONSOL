@using DmxConsole.Core.Engine
@using DmxConsole.Core.Fixtures
@implements IDisposable
@inject MainViewModel Vm

@*
    Phase H1's first real View redesign. Must answer, at a glance: what channel is this, what
    level is it at, is it selected, is it active, and who owns it right now (Step F's
    DmxOutputEngine.GetOwner) - never raw DMX as the primary language (channel identity is
    Fixture.Number + attribute name, not a universe/address pair).
*@

<div class="channels-view">
    <div class="channels-view-header">
        <span class="channels-view-title">Channels</span>
        <select class="pane-add-view channels-filter" @bind="_filter" aria-label="Filter channels">
            <option value="All">All</option>
            <option value="Selected">Selected</option>
            <option value="Active">Active</option>
            <option value="Programmer">Programmer</option>
        </select>
        <span class="channels-legend"><i class="legend-dot selected"></i>Selected <i class="legend-dot active"></i>Live <i class="legend-dot programmer"></i>Programmer</span>
        <span class="channels-view-count">@Vm.SelectionVm.Selection.Items.Count selected</span>
        @if (Vm.SelectionVm.Selection.Items.Count > 0)
        {
            <button class="btn" @onclick="ClearSelection">Clear</button>
        }
    </div>

    <div class="channels-table-scroll">
        <table class="data-list channels-table">
            <thead>
                <tr>
                    <th>CH</th>
                    <th class="fixture-name-column">Fixture</th>
                    <th>Attribute</th>
                    <th>Level</th>
                    <th class="source-column">Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fader in FilteredFaders())
                {
                    var owner = Vm.Engine.GetOwner(fader.UniverseId, fader.ChannelIndex);
                    bool isSelected = Vm.SelectionVm.Selection.Contains(fader.Fixture);
                    bool isActive = owner is not null;
                    bool isProgrammer = Vm.Programmer.HasStoredValue(fader.UniverseId, fader.ChannelIndex, out var programmerValue);
                    int levelPercent = (int)Math.Round(Vm.Engine.GetEffectiveValue(fader.UniverseId, fader.ChannelIndex) / 255.0 * 100);

                    <tr class="channels-row @(isSelected ? "selected" : "") @(isActive ? "active" : "") @(isProgrammer ? "programmer" : "")" @onclick="() => Toggle(fader.Fixture)">
                        <td class="ch-cell">@($"{fader.Fixture.Number}.{OrdinalWithin(fader)}")</td>
                        <td class="fixture-name-column">@fader.FixtureName</td>
                        <td><span class="attribute-name">@fader.ChannelTypeName</span>@if (isProgrammer) { <span class="programmer-chip" title="Programmer captured value">P @Percent(programmerValue)%</span> }</td>
                        <td class="level-cell">
                            <div class="level-bar"><div class="level-bar-fill" style="width:@(levelPercent)%"></div></div>
                            <span>@levelPercent%</span>
                        </td>
                        <td class="source-cell source-column @ProvenanceClassifier.CssClass(ProvenanceClassifier.Classify(owner))">@DescribeOwner(owner)</td>
                    </tr>
                }
                @if (Vm.Faders.Count == 0)
                {
                    <tr><td colspan="5" class="channels-empty">No fixtures patched yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private System.Threading.Timer? _liveTimer;
    private string _filter = "All";

    protected override void OnInitialized()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged += OnChanged;
        Vm.Faders.CollectionChanged += OnChanged;
        // Level/ownership change continuously while a Cue fades or an Effect runs - a timer is
        // the same "poll the engine's live state" approach CueListViewModel already uses for its
        // own progress display, just applied here for the same reason.
        _liveTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 200, 200);
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private IEnumerable<ChannelFaderViewModel> FilteredFaders() => _filter switch
    {
        "Selected" => Vm.Faders.Where(f => Vm.SelectionVm.Selection.Contains(f.Fixture)),
        "Active" => Vm.Faders.Where(f => Vm.Engine.GetOwner(f.UniverseId, f.ChannelIndex) is not null),
        "Programmer" => Vm.Faders.Where(f => Vm.Programmer.HasStoredValue(f.UniverseId, f.ChannelIndex, out _)),
        _ => Vm.Faders,
    };

    private static int Percent(byte value) => (int)Math.Round(value / 255.0 * 100);

    private void Toggle(PatchedFixture fixture)
    {
        Vm.SelectionVm.TapFixtureNumberCommand.Execute(fixture);
        Vm.CommandSurfaceVm.SynchronizeFixtureSelection(Vm.SelectionVm.Selection.Items);
        // H1.6 §5/§19 - clicking a Fixture enters the same shared EditorContext a Command
        // Surface "Fixture N" would, so the Editor Tool Bar reacts without a second click.
        Vm.EditorContext.EnterObject(DmxConsole.Web.EditorToolBar.EditorObjectType.Fixture, "FIXTURE", fixture, $"Fixture {fixture.Number}");
    }

    private void ClearSelection()
    {
        Vm.SelectionVm.ClearSelectionCommand.Execute(null);
        Vm.CommandSurfaceVm.SynchronizeFixtureSelection(Vm.SelectionVm.Selection.Items);
    }

    private static int OrdinalWithin(ChannelFaderViewModel fader)
    {
        var channels = fader.Fixture.Mode.Channels;
        for (int i = 0; i < channels.Count; i++)
            if (ReferenceEquals(channels[i], fader.Channel)) return i + 1;
        return 0;
    }

    private string DescribeOwner(OutputOwner? owner)
    {
        if (owner is null) return "—";
        if (owner.Kind == OwnerKind.Executor) return ProvenanceClassifier.DescribeExecutorOwner(owner, Vm.ExecutorVm.Bank);
        return owner.DisplayName;
    }

    public void Dispose()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged -= OnChanged;
        Vm.Faders.CollectionChanged -= OnChanged;
        _liveTimer?.Dispose();
    }
}
