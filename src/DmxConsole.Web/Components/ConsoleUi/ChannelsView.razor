@using DmxConsole.Core.Engine
@using DmxConsole.Core.Fixtures
@implements IDisposable
@inject MainViewModel Vm

@*
    Phase H1's first real View redesign. Must answer, at a glance: what channel is this, what
    level is it at, is it selected, is it active, and who owns it right now (Step F's
    DmxOutputEngine.GetOwner) - never raw DMX as the primary language (channel identity is
    Fixture.Number + attribute name, not a universe/address pair).
*@

<div class="channels-view">
    <div class="channels-view-header">
        <span class="channels-view-title">Channels</span>
        <span class="channels-view-count">@Vm.SelectionVm.Selection.Items.Count selected</span>
        @if (Vm.SelectionVm.Selection.Items.Count > 0)
        {
            <button class="btn" @onclick="ClearSelection">Clear</button>
        }
    </div>

    <div class="channels-table-scroll">
        <table class="data-list channels-table">
            <thead>
                <tr>
                    <th>CH</th>
                    <th>Fixture</th>
                    <th>Attribute</th>
                    <th>Level</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fader in Vm.Faders)
                {
                    var owner = Vm.Engine.GetOwner(fader.UniverseId, fader.ChannelIndex);
                    bool isSelected = Vm.SelectionVm.Selection.Contains(fader.Fixture);
                    bool isActive = owner is not null;
                    int levelPercent = (int)Math.Round(Vm.Engine.GetEffectiveValue(fader.UniverseId, fader.ChannelIndex) / 255.0 * 100);

                    <tr class="channels-row @(isSelected ? "selected" : "") @(isActive ? "active" : "")" @onclick="() => Toggle(fader.Fixture)">
                        <td class="ch-cell">@($"{fader.Fixture.Number}.{OrdinalWithin(fader)}")</td>
                        <td>@fader.FixtureName</td>
                        <td>@fader.ChannelTypeName</td>
                        <td class="level-cell">
                            <div class="level-bar"><div class="level-bar-fill" style="width:@(levelPercent)%"></div></div>
                            <span>@levelPercent%</span>
                        </td>
                        <td class="source-cell @SourceCssClass(owner)">@DescribeOwner(owner)</td>
                    </tr>
                }
                @if (Vm.Faders.Count == 0)
                {
                    <tr><td colspan="5" class="channels-empty">No fixtures patched yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private System.Threading.Timer? _liveTimer;

    protected override void OnInitialized()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged += OnChanged;
        Vm.Faders.CollectionChanged += OnChanged;
        // Level/ownership change continuously while a Cue fades or an Effect runs - a timer is
        // the same "poll the engine's live state" approach CueListViewModel already uses for its
        // own progress display, just applied here for the same reason.
        _liveTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 200, 200);
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private void Toggle(PatchedFixture fixture) =>
        Vm.SelectionVm.TapFixtureNumberCommand.Execute(fixture);

    private void ClearSelection() => Vm.SelectionVm.ClearSelectionCommand.Execute(null);

    private static int OrdinalWithin(ChannelFaderViewModel fader)
    {
        var channels = fader.Fixture.Mode.Channels;
        for (int i = 0; i < channels.Count; i++)
            if (ReferenceEquals(channels[i], fader.Channel)) return i + 1;
        return 0;
    }

    private string DescribeOwner(OutputOwner? owner)
    {
        if (owner is null) return "—";

        if (owner.Kind == OwnerKind.Executor)
        {
            var executor = Vm.ExecutorVm.Bank.Executors.FirstOrDefault(e => e.Id == owner.ExecutorId);
            string label = $"Exec {owner.ExecutorNumber}";
            if (executor?.GetStatus() is CueListPlaybackStatus { CurrentCue: { } cue })
            {
                string cueLabel = string.IsNullOrWhiteSpace(cue.Name) ? $"Cue {cue.Number}" : cue.Name;
                label += $" / {cueLabel}";
            }
            return label;
        }

        return owner.DisplayName;
    }

    private static string SourceCssClass(OutputOwner? owner) => owner?.Kind switch
    {
        OwnerKind.Programmer => "src-programmer",
        OwnerKind.Executor => "src-executor",
        OwnerKind.Effect => "src-effect",
        _ => "src-none",
    };

    public void Dispose()
    {
        Vm.SelectionVm.Selection.Items.CollectionChanged -= OnChanged;
        Vm.Faders.CollectionChanged -= OnChanged;
        _liveTimer?.Dispose();
    }
}
