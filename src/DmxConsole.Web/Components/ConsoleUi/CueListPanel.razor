@implements IDisposable
@inject MainViewModel Vm
@using DmxConsole.Core.Engine

<div style="display:contents">
    <div class="scroll-y">
        <div class="field"><label>#</label><input type="number" step="0.5" @bind="Cues.NewCueNumber" style="width:70px" /></div>
        <div class="field"><label>Name</label><input type="text" @bind="Cues.NewCueName" style="width:150px" /></div>
        <div class="field">
            <label>Time In</label><input type="number" step="0.1" @bind="Cues.NewTimeInSeconds" style="width:60px" />
            <label style="min-width:auto">Out</label><input type="number" step="0.1" @bind="Cues.NewTimeOutSeconds" style="width:60px" />
        </div>
        <div class="field">
            <label>Delay In</label><input type="number" step="0.1" @bind="Cues.NewDelayInSeconds" style="width:60px" />
            <label style="min-width:auto">Out</label><input type="number" step="0.1" @bind="Cues.NewDelayOutSeconds" style="width:60px" />
        </div>
        <div class="field">
            <label>Wait</label><input type="number" step="0.1" @bind="Cues.NewWaitSeconds" style="width:60px" />
            <label style="min-width:auto">Trigger</label>
            <select @bind="Cues.NewTriggerMode" style="width:90px">
                <option value="@CueTriggerMode.Manual">MANUAL</option>
                <option value="@CueTriggerMode.Follow">FOLLOW ON</option>
            </select>
        </div>
        <div class="field">
            <label>Store</label>
            <select @bind="Cues.StoreFilter" style="width:170px">
                <option value="@CueStoreFilter.AllStage">ALL STAGE</option>
                <option value="@CueStoreFilter.AllEditor">ALL EDITOR</option>
                <option value="@CueStoreFilter.ActiveOnly">ACTIVE ONLY</option>
                <option value="@CueStoreFilter.AllParamsForSelected">ALL PARAMS FOR SELECTED</option>
                <option value="@CueStoreFilter.AllParamsIfActive">ALL PARAMS IF ACTIVE</option>
            </select>
        </div>
        <div style="display:flex; gap:6px; margin-bottom:6px">
            <button class="btn btn-go" style="flex:1" @onclick="() => Cues.StoreCueCommand.Execute(null)">● Store Cue @(Cues.NewCueNumber.ToString("0.##"))</button>
            <button class="btn" style="flex:1" @onclick="() => Cues.UpdateCueCommand.Execute(null)">⟳ Update Cue @(Cues.NewCueNumber.ToString("0.##"))</button>
        </div>
        @if (!string.IsNullOrEmpty(Cues.StatusMessage))
        {
            <div style="font-size:12px; color:var(--text-dim); margin-bottom:8px">@Cues.StatusMessage</div>
        }

        <div style="display:flex; gap:6px; margin-bottom:8px">
            <button class="btn" @onclick="() => Cues.BackCommand.Execute(null)">◀ Back</button>
            <button class="btn btn-go" @onclick="() => Cues.GoCommand.Execute(null)">GO</button>
            <button class="btn" @onclick="() => Cues.StopCommand.Execute(null)">Stop</button>
        </div>

        <div style="font-size:13px; margin-bottom:4px">Active: @Cues.CurrentCueLabel</div>
        <div class="progress-bar"><div style="width:@((Cues.TransitionProgress * 100).ToString("0"))%"></div></div>
        <div style="font-size:11px; color:var(--text-dim); margin-top:2px">@Cues.RemainingTimeText</div>
    </div>

    <div class="scroll-y">
        <table class="data-list">
            <thead><tr><th>#</th><th>Name</th><th>Time In</th><th>Time Out</th><th>Trigger</th><th></th></tr></thead>
            <tbody>
                @foreach (var cue in Cues.CueList.Cues)
                {
                    <tr class="cue-row @(cue == Cues.CueList.CurrentCue && Cues.IsActive ? "active-row" : "")"
                        title="Click to load into Store/Update fields - double-click to jump playback here"
                        @onclick="() => SelectForContext(cue)"
                        @ondblclick="() => Cues.GoToCueCommand.Execute(cue)">
                        <td>@cue.Number</td>
                        <td>@cue.Name</td>
                        <td>@cue.Timing.TimeIn</td>
                        <td>@cue.Timing.TimeOut</td>
                        <td>@(cue.TriggerMode == CueTriggerMode.Follow ? "FOLLOW" : "MANUAL")</td>
                        <td><button class="btn" style="min-height:32px;padding:2px 10px" @onclick="() => Cues.RemoveCueCommand.Execute(cue)" @onclick:stopPropagation="true">✕</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private CueListViewModel Cues => Vm.CueListVm;

    private void SelectForContext(DmxConsole.Core.Engine.Cue cue)
    {
        Cues.LoadForEditCommand.Execute(cue);
        // H1.6 §5 - clicking a Cue enters the shared EditorContext automatically (Scenario A) -
        // the operator never has to press a separate "CUE" key after clicking one in the list.
        Vm.EditorContext.EnterObject(DmxConsole.Web.EditorToolBar.EditorObjectType.Cue, "CUE", cue, $"Cue {cue.Number:0.##}");
    }

    protected override void OnInitialized()
    {
        Cues.PropertyChanged += OnChanged;
        Cues.CueList.Cues.CollectionChanged += OnChanged;
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Cues.PropertyChanged -= OnChanged;
        Cues.CueList.Cues.CollectionChanged -= OnChanged;
    }
}
