@using DmxConsole.Application.CommandSurface
@using DmxConsole.Core
@using DmxConsole.Web.CommandSurface
@using DmxConsole.Web.Services
@inject MainViewModel Vm
@implements IDisposable

@*
    Persistent console infrastructure per H1.5 - lives outside the pane tree, alongside
    ConsoleChrome/CommandLine, never a closable View/Pane. The operator's actual controls for
    composing commands. Buttons here never mutate console state directly - each one only calls
    CommandSurfaceViewModel, which pushes a structured CommandToken into CommandComposer (or, for
    RELEASE/SHIFT's own two-press gestures, calls a small dedicated method) - only a complete/
    Enter'd composition, or an explicit self-terminating action, is ever dispatched through the
    existing Application layer. This is deliberately not one Razor component with hardcoded
    per-button business logic - every button below is a thin proxy to
    CommandSurfaceViewModel/KeyboardCommandMap, nothing else.

    Layout follows docs/COMMAND_SURFACE_KEY_SPEC.md §20's spatial guidance (a concept sketch, not
    a pixel-exact template): a LEFT action bank (object keys, Shift, Release, Clear) and a RIGHT
    command bank (family keys + Preset, Home/Full, Next/Last, the numeric cluster with At/Thru/+/-
    interleaved, Enter). There is exactly ONE fixed CLEAR key, in the left action bank alongside
    Shift/Release - it used to also be duplicated next to Enter in the numeric cluster, which is
    now removed (§B: "only ONE operator CLEAR semantic" applies to the physical key layout too,
    not just to the UI entry points that call it). Preserves the existing DMX-CONSOL touch-target
    sizing and CSS token language (.key/.key-num/.key-op/etc.) rather than introducing a new
    visual system.

    Collapsible (work-plan follow-up to Milestone 1): fixed, always present, but foldable down
    to reclaim screen space - same open/closed pattern as EncoderDrawer, its row-mate in
    .console-input-row.
*@

@if (!Sfc.IsOpen)
{
    <div class="command-surface command-surface-collapsed" @onclick="Sfc.Open">
        <span class="command-surface-collapsed-label">KEYPAD</span>
        <button class="editor-nav-btn" title="Open keypad" @onclick="Sfc.Open" @onclick:stopPropagation="true">▲ OPEN</button>
    </div>
}
else
{
    <div class="command-surface-column">
        <ParameterPicker />
        <div class="command-surface" tabindex="0" @onkeydown="OnKeyDown">
        @if (Sfc.ReleaseArmed)
        {
            @* RELEASE-panel slice (§C/§D): first RELEASE press only arms this - no Programmer/
               Selection mutation yet. Choosing a family never fixture attributes (RED/GREEN/PAN/
               TILT live on the Encoder Drawer, not here) - only the six AttributeClass families
               plus ALL. ENTER or a second RELEASE press confirms; CLEAR dismisses immediately. *@
            <div class="keypad-row release-context-panel" role="group" aria-label="Release context">
                <button class="key key-danger @(Sfc.ArmedReleaseFamilies.Count == 0 ? "active" : "")" @onclick="Sfc.SelectReleaseAll">All</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Intensity) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Intensity)">Intensity</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Position) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Position)">Position</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Color) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Color)">Color</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Beam) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Beam)">Beam</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Image) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Image)">Image</button>
                <button class="key key-family @(Sfc.ArmedReleaseFamilies.Contains(AttributeClass.Shape) ? "active" : "")" @onclick="() => Sfc.ToggleReleaseFamily(AttributeClass.Shape)">Shape</button>
            </div>
        }
        @if (Sfc.StoreFamilyChoiceArmed)
        {
            @* Store-grammar slice (§C): a bare "STORE PRESET ENTER", or "STORE PRESET n ENTER"
               with more than one touched PROGRAMMER family, arms this - never a silent guess.
               "All" pre-checks every touched family; ENTER confirms (or the button below, if a
               number still needs to be typed for the bare-PRESET form). *@
            <div class="keypad-row store-context-panel" role="group" aria-label="Store Preset family choice">
                <button class="key key-danger" @onclick="Sfc.SelectAllStoreFamilies">All</button>
                @foreach (var family in Sfc.StoreFamilyCandidates)
                {
                    <button class="key key-family @(Sfc.SelectedStoreFamilies.Contains(family) ? "active" : "")" @onclick="() => Sfc.ToggleStoreFamily(family)">@family</button>
                }
            </div>
            @if (Sfc.StoreFamilyChoiceNeedsNumber)
            {
                <div class="keypad-row store-context-panel">
                    <label>
                        Preset #
                        <input type="number" value="@Sfc.PendingStorePresetNumberInput"
                               @onchange="@((ChangeEventArgs e) => Sfc.PendingStorePresetNumberInput = int.TryParse(e.Value?.ToString(), out var n) ? n : null)" />
                    </label>
                </div>
            }
            <div class="keypad-row store-context-panel">
                <button class="key" @onclick="Sfc.ConfirmStoreFamilyChoice">Enter</button>
                <button class="key key-danger" @onclick="Sfc.CancelStoreFamilyChoice">Cancel</button>
            </div>
        }
        @if (Sfc.StoreConflictChoiceArmed)
        {
            @* Store-grammar slice (§C): one or more of the resolved families already have a
               Preset at this number - the operator must choose, never silently merge/overwrite.
               One shared choice applies to every conflicting family in this transaction. *@
            <div class="keypad-row store-context-panel" role="group" aria-label="Store Preset conflict">
                <span>Preset already exists: @string.Join(", ", Sfc.StoreConflictFamilies)</span>
                <button class="key key-danger" @onclick="Sfc.ResolveStoreConflictOverwrite">Overwrite</button>
                <button class="key" @onclick="Sfc.ResolveStoreConflictUpdate">Update</button>
                <button class="key key-danger" @onclick="Sfc.ResolveStoreConflictCancel">Cancel</button>
            </div>
        }
        <div class="command-bank command-bank-left">
            <div class="keypad-row">
                <button class="key key-object" @onclick="() => PressToken(CommandTokenKind.Fixture)">Fixture</button>
                <button class="key key-object" @onclick="() => PressToken(CommandTokenKind.Group)">Group</button>
            </div>
            <div class="keypad-row">
                <button class="key key-object" @onclick="() => PressToken(CommandTokenKind.Cue)">Cue</button>
                <button class="key key-object" disabled title="Cue List - selecting/switching between multiple Cue Lists is not implemented yet (this console currently drives a single Cue List)">Cue List</button>
                <button class="key key-object" @onclick="() => PressToken(CommandTokenKind.Dmx)" title="Direct DMX addressing - Universe.Address, independent of any Fixture Profile">DMX</button>
            </div>
            <div class="keypad-row">
                <button class="key @(Sfc.ShiftArmed ? "key-shift-armed" : "")" @onclick="Sfc.PressCapture" title="Capture - not implemented without Shift yet. Shift+Capture captures the current effective LIVE output into the Programmer (Capture All).">Capture</button>
            </div>
            <div class="keypad-row">
                <button class="key" disabled title="Effect - not implemented on the Command Surface yet (use the Effects panel)">Effect</button>
                @* Cue-timing bug fix slice: TIME is real CommandComposer grammar ("CUE <n> [THRU <n>]
                   TIME <value>[/<value>] ENTER" - CommandComposer.ResolveCueCommand/ResolveCueTiming)
                   - a FIXED key (CLAUDE.md §12), always present, whose enabled state is derived from
                   the shared grammar via CanPressToken (the same probe the contextual "/" softkey
                   above already uses - CLAUDE.md §4, one grammar, no UI-owned semantics), never a
                   second, Razor-local notion of "when is Cue timing available". *@
                <button class="key" disabled="@(!Sfc.CanPressToken(CommandTokenKind.Timing))" @onclick="() => PressToken(CommandTokenKind.Timing)" title="Time - sets Cue fade timing: CUE n [THRU n] TIME value[/value] ENTER">Time</button>
                <button class="key" disabled title="Fan - spreading a value across a fixture range is not implemented yet">Fan</button>
            </div>
            <div class="keypad-row">
                <button class="key @(Sfc.IsRecordingMacro ? "key-macro-recording" : Sfc.IsLearnArmed ? "key-macro-armed" : "")"
                        @onclick="Sfc.PressLearnMacro"
                        title="LEARN MACRO - press a MACRO key to choose the slot to record into; press LEARN MACRO again to stop and save">
                    Learn Macro
                </button>
            </div>
            <div class="keypad-row">
                <button class="key key-macro @(Sfc.RecordingMacroSlot == 1 ? "key-macro-recording" : "")" @onclick="() => Sfc.PressMacroSlot(1)" title="Macro 1 - Shift+Macro 1 = Macro 5">Macro 1</button>
                <button class="key key-macro @(Sfc.RecordingMacroSlot == 2 ? "key-macro-recording" : "")" @onclick="() => Sfc.PressMacroSlot(2)" title="Macro 2 - Shift+Macro 2 = Macro 6">Macro 2</button>
            </div>
            <div class="keypad-row">
                <button class="key key-macro @(Sfc.RecordingMacroSlot == 3 ? "key-macro-recording" : "")" @onclick="() => Sfc.PressMacroSlot(3)" title="Macro 3 - Shift+Macro 3 = Macro 7">Macro 3</button>
                <button class="key key-macro @(Sfc.RecordingMacroSlot == 4 ? "key-macro-recording" : "")" @onclick="() => Sfc.PressMacroSlot(4)" title="Macro 4 - Shift+Macro 4 = Macro 8">Macro 4</button>
            </div>
            <div class="keypad-row keypad-row-spacer"></div>
            <div class="keypad-row">
                <button class="key @(Sfc.ShiftArmed ? "key-shift-armed" : "")" @onclick="Sfc.PressShift" title="Shift - modifies the next key press (only Shift+Release is defined in v1)">Shift</button>
            </div>
            <div class="keypad-row">
                <button class="key key-danger @(Sfc.ReleaseArmed ? "key-shift-armed" : "")" @onclick="Sfc.PressRelease" title="Release - arms a family-choice panel; press again or Enter to confirm. Shift+Release releases all playbacks.">Release</button>
            </div>
            <div class="keypad-row">
                <button class="key key-danger" @onclick="Sfc.PressClear">Clear</button>
            </div>
        </div>

        <div class="command-bank command-bank-right">
            <div class="keypad-row">
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Intensity)">Intensity</button>
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Position)">Position</button>
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Color)">Color</button>
            </div>
            <div class="keypad-row">
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Beam)">Beam</button>
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Image)">Image</button>
                <button class="key key-family" @onclick="() => PressToken(CommandTokenKind.Shape)">Shape</button>
            </div>
            <div class="keypad-row">
                <button class="key" @onclick="() => PressToken(CommandTokenKind.Preset)">Preset</button>
                <button class="key" @onclick="() => PressToken(CommandTokenKind.Home)">Home</button>
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Full)">Full</button>
            </div>
            <div class="keypad-row">
                <button class="key" @onclick="() => PressToken(CommandTokenKind.Next)">Next</button>
                <button class="key" @onclick="() => PressToken(CommandTokenKind.Previous)">Last</button>
            </div>
            <div class="keypad-row">
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.At)">At</button>
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Thru)">Thru</button>
            </div>
            <div class="keypad-row">
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Odd)" title="Odd - filters the current Selection down to its odd 1-based positions (Selection order, not fixture numbers)">Odd</button>
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Even)" title="Even - filters the current Selection down to its even 1-based positions (Selection order, not fixture numbers)">Even</button>
            </div>
            @* Cue TIME split syntax slice, revised (permanent-key decision): "/" is a FIXED key,
               always present, like every other syntax key on this surface (CLAUDE.md §12 - object/
               family keys are contextual by role, not by visibility gating; ODD/EVEN/REVERSE are
               the only keys documented to be contextual softkeys, and "/" is not one of them). The
               earlier revision hid this key unless CommandSurfaceViewModel.CanPressToken reported
               the composer would accept Slash next - that made the key invisible/undiscoverable
               outside one narrow moment of Cue TIME entry, which is wrong for a permanent physical
               key. Grammar validity is still enforced exactly the same way as any other key: pressing
               "/" where it's not syntactically valid reaches CommandComposer.Push generically
               (CLAUDE.md §4 - no separate UI-side validation), which rejects it cleanly with an
               Incomplete/Error result and no state mutation - see CommandComposerCueTimingTests and
               CommandSurfaceViewModelSlashPermanentTests for both sides of that behavior. *@
            <div class="keypad-row">
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Slash)" title="Slash - splits a Cue TIME value into separate In/Out times, e.g. TIME 8/10">/</button>
            </div>
            @* Numeric keypad layout fix: 0-9/./Backspace form one uniform 3-column grid (all
               .key-num, no key-wide override) - +/- move to their own row below it so they never
               distort the digit grid's column widths, and Enter stands alone in its own row. *@
            <div class="keypad-row">
                <button class="key key-num" @onclick="() => PressDigit('7')">7</button>
                <button class="key key-num" @onclick="() => PressDigit('8')">8</button>
                <button class="key key-num" @onclick="() => PressDigit('9')">9</button>
            </div>
            <div class="keypad-row">
                <button class="key key-num" @onclick="() => PressDigit('4')">4</button>
                <button class="key key-num" @onclick="() => PressDigit('5')">5</button>
                <button class="key key-num" @onclick="() => PressDigit('6')">6</button>
            </div>
            <div class="keypad-row">
                <button class="key key-num" @onclick="() => PressDigit('1')">1</button>
                <button class="key key-num" @onclick="() => PressDigit('2')">2</button>
                <button class="key key-num" @onclick="() => PressDigit('3')">3</button>
            </div>
            <div class="keypad-row">
                <button class="key key-num" @onclick="() => PressDigit('0')">0</button>
                <button class="key key-num" @onclick="PressDecimalPoint">.</button>
                <button class="key key-num" @onclick="Sfc.PressBackspace">⌫</button>
            </div>
            <div class="keypad-row keypad-row-spacer"></div>
            <div class="keypad-row">
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Plus)">+</button>
                <button class="key key-op" @onclick="() => PressToken(CommandTokenKind.Minus)">-</button>
            </div>
            <div class="keypad-row keypad-row-spacer"></div>
            <div class="keypad-row">
                <button class="key key-enter" @onclick="() => PressToken(CommandTokenKind.Enter)">Enter</button>
            </div>
            <div class="keypad-row">
                <button class="editor-nav-btn command-surface-close" title="Close keypad" @onclick="Sfc.Close">▼ CLOSE</button>
            </div>
        </div>

        @* Command Surface key-map completion + Store-grammar slice: Editing/Store, History/Setup
           and Playback - a third fixed bank. STORE is real CommandComposer grammar
           ("&lt;selection&gt; STORE &lt;Group|Cue|Preset|family&gt; &lt;number&gt; ENTER") -
           pressing it only enters the Task line and waits (see the family/conflict panels above),
           never an immediate ViewModel shortcut. UPDATE/DELETE/GOTO are unchanged: routed by
           CommandSurfaceViewModel.PressUpdate/PressDelete/PressGoTo (the shared EditorContext
           decides Group vs Cue) - this markup is a thin proxy with zero routing logic of its own.
           UNDO/REDO/GO/BACK reuse the exact existing MainViewModel/CueListViewModel commands the
           Toolbar/Cues panel already dispatch - a second entry point for the same operation, never
           a second implementation (architecture rule). EDIT/LOAD/COPY/MOVE/EXAM/SETUP have no
           underlying implementation anywhere in this console yet and are disabled, honestly,
           rather than faked. *@
        <div class="command-bank command-bank-store">
            <div class="keypad-row">
                <button class="key" @onclick="Sfc.PressStore" title="Store - enters STORE into the Task line; follow with GROUP/CUE/PRESET (or a family) and a number, then Enter">Store</button>
                <button class="key" @onclick="Sfc.PressUpdate" title="Update - updates the current Group/Cue in context">Update</button>
            </div>
            <div class="keypad-row">
                <button class="key key-danger" @onclick="Sfc.PressDelete" title="Delete - deletes the current Group/Cue in context">Delete</button>
            </div>
            <div class="keypad-row">
                <button class="key" disabled title="Edit - not implemented on the Command Surface yet">Edit</button>
                <button class="key" disabled title="Load - not implemented on the Command Surface yet">Load</button>
            </div>
            <div class="keypad-row">
                <button class="key" disabled title="Copy - not implemented yet">Copy</button>
                <button class="key" disabled title="Move - not implemented yet">Move</button>
            </div>
            <div class="keypad-row keypad-row-spacer"></div>
            <div class="keypad-row">
                <button class="key" @onclick="() => Vm.UndoCommand.Execute(null)" title="Undo - same Undo history as the Toolbar's own Undo">Undo</button>
                <button class="key" @onclick="() => Vm.RedoCommand.Execute(null)" title="Redo - same Redo history as the Toolbar's own Redo">Redo</button>
            </div>
            <div class="keypad-row">
                <button class="key" disabled title="Exam - inspecting what a fixture/channel is currently doing and why is not implemented on the Command Surface yet">Exam</button>
                <button class="key" disabled title="Setup - console/system setup is not implemented yet">Setup</button>
            </div>
            <div class="keypad-row keypad-row-spacer"></div>
            @* SHIFT+GO/SHIFT+BACK slice: Go/Back now route through Sfc (which reads and consumes
               the existing Shift modifier) instead of calling CueListVm's GO/Back RelayCommands
               directly - Shift+Go/Shift+Back dispatch a zero-time jump via the same shared
               CueList path, never a second cue-application mechanism. The key-shift-armed class
               (already used by Shift/Release) makes an armed Shift visible on these two keys too. *@
            <div class="keypad-row">
                <button class="key key-op @(Sfc.ShiftArmed ? "key-shift-armed" : "")" @onclick="Sfc.PressGo" title="Go - advances the Cue List. Shift+Go = instant, zero-time jump (no fade), and never arms AutoFollow.">Go</button>
                <button class="key @(Sfc.ShiftArmed ? "key-shift-armed" : "")" @onclick="Sfc.PressBack" title="Back/Pause - steps the Cue List back. Shift+Back = instant, zero-time jump (no fade), and never arms AutoFollow.">Back/Pause</button>
            </div>
            <div class="keypad-row">
                <button class="key" @onclick="Sfc.PressGoTo" title="Go To - jumps the Cue List directly to the Cue currently in context (click a Cue row first)">Go To</button>
            </div>
        </div>
        </div>
    </div>
}

@code {
    private CommandSurfaceViewModel Sfc => Vm.CommandSurfaceVm;

    protected override void OnInitialized() => Sfc.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void PressDigit(char digit) => Sfc.PressDigit(digit);

    private void PressDecimalPoint() => Sfc.PressDecimalPoint();

    private void PressToken(CommandTokenKind kind) => Sfc.PressToken(kind);

    /// <summary>A physical keyboard resolves to the exact same tokens a touch press would,
    /// via the single shared KeyboardCommandMap - see that type's own doc comment.</summary>
    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (!KeyboardCommandMap.TryResolve(e.Key, out var binding)) return;

        if (binding.Digit is char digit)
        {
            if (digit == '.') Sfc.PressDecimalPoint();
            else Sfc.PressDigit(digit);
            return;
        }

        if (binding.TokenKind is CommandTokenKind kind)
        {
            if (kind == CommandTokenKind.Backspace) Sfc.PressBackspace();
            else if (kind == CommandTokenKind.Clear) Sfc.PressClear();
            else if (kind == CommandTokenKind.Release) Sfc.PressRelease();
            else if (kind == CommandTokenKind.CaptureAll) Sfc.PressCapture();
            else Sfc.PressToken(kind);
        }
    }

    public void Dispose() => Sfc.Changed -= OnChanged;
}
