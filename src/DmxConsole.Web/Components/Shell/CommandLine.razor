@using DmxConsole.Web.Services
@inject MainViewModel Vm
@implements IDisposable

@*
    Persistent console infrastructure per H1.5 - lives outside the pane tree, alongside
    ConsoleChrome, never a closable View. Shows the command currently being composed
    (CommandComposer's structured state, rendered - never re-parsed, see CommandComposition's
    own doc comment), unresolved/ambiguous state, and errors/warnings. The rendered text is a
    view of the structured composition, never the source of truth.
*@

@* MACROS §13 - recording state must be clearly visible, never hidden, and never hides the
   normal command-line feedback below it. *@
@if (Sfc.IsRecordingMacro)
{
    <div class="command-line-macro-status command-line-macro-recording">
        <span class="macro-recording-dot"></span>
        <span>LEARN MACRO @Sfc.RecordingMacroSlot RECORDING</span>
        <button class="macro-recording-cancel" @onclick="Sfc.CancelLearnMacro">Cancel</button>
    </div>
}
else if (Sfc.IsLearnArmed)
{
    <div class="command-line-macro-status command-line-macro-armed">LEARN MACRO - press a MACRO key to choose a slot</div>
}

<div class="command-line @(HasError ? "has-error" : "")">
    <span class="command-line-prompt">&gt;</span>
    <span class="command-line-text">@(string.IsNullOrEmpty(Sfc.DisplayPreview) ? " " : Sfc.DisplayPreview)</span>
    @if (HasError)
    {
        <span class="command-line-error">@ErrorText</span>
    }
    @if (Sfc.Current.ExpectedNext.Count > 0 && !HasError)
    {
        <span class="command-line-expected">expects: @string.Join(" / ", Sfc.Current.ExpectedNext)</span>
    }
</div>

@code {
    private CommandSurfaceViewModel Sfc => Vm.CommandSurfaceVm;

    private string? ErrorText => Sfc.DispatchError ?? Sfc.Current.Error;
    private bool HasError => ErrorText is not null;

    protected override void OnInitialized() => Sfc.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sfc.Changed -= OnChanged;
}
