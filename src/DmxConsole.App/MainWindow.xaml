<Window x:Class="DmxConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DmxConsole.App"
        xmlns:vm="clr-namespace:DmxConsole.App.ViewModels"
        mc:Ignorable="d"
        Title="DMX Console" Height="720" Width="1200"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: engine + protocol output controls -->
        <Border Grid.Row="0" Background="#FF2A2A2A" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Start Engine" Command="{Binding StartEngineCommand}" IsEnabled="{Binding IsEngineRunning, Converter={x:Static local:BoolInverter.Instance}}"/>
                <Button Content="Stop Engine" Command="{Binding StopEngineCommand}" IsEnabled="{Binding IsEngineRunning}"/>
                <Button Content="Clear Programmer" Command="{Binding ClearProgrammerCommand}"/>

                <Separator Margin="12,0" Width="1" Background="#FF444444"/>

                <CheckBox Content="Art-Net" IsChecked="{Binding ArtNetEnabled}"/>
                <TextBox Text="{Binding ArtNetTargetIp, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalContentAlignment="Center"/>
                <Button Content="Apply Target" Command="{Binding ApplyArtNetTargetCommand}"/>

                <Separator Margin="12,0" Width="1" Background="#FF444444"/>

                <CheckBox Content="sACN / E1.31" IsChecked="{Binding SacnEnabled}"/>
            </StackPanel>
        </Border>

        <!-- Main content: Patch (left) + Fader bank (right) -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Patch panel -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Patch" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

                <Border DockPanel.Dock="Top" Background="#FF2A2A2A" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Profile:" Width="70"/>
                            <ComboBox Width="230" ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Mode:" Width="70"/>
                            <ComboBox Width="230" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Name:" Width="70"/>
                            <TextBox Width="230" Text="{Binding NewFixtureName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Label Content="Universe:" Width="70"/>
                            <TextBox Width="80" Text="{Binding NewUniverseId, UpdateSourceTrigger=PropertyChanged}"/>
                            <Label Content="Address:" Width="70"/>
                            <TextBox Width="80" Text="{Binding NewStartAddress, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Add Fixture" Command="{Binding AddFixtureCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Patch.Fixtures}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          Background="#FF252525" Foreground="White" RowBackground="#FF252525" AlternatingRowBackground="#FF2C2C2C">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="Fixture" Binding="{Binding Profile.DisplayName}" Width="130"/>
                        <DataGridTextColumn Header="Uni" Binding="{Binding UniverseId}" Width="40"/>
                        <DataGridTextColumn Header="Addr" Binding="{Binding StartAddress}" Width="45"/>
                        <DataGridTextColumn Header="Fp" Binding="{Binding Footprint}" Width="35"/>
                        <DataGridTemplateColumn Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveFixtureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Fader bank -->
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Faders (Programmer)" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Faders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelFaderViewModel}">
                                <Border Background="#FF2A2A2A" Margin="4" Padding="8" Width="110">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FixtureName}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ChannelLabel}" FontSize="11" Foreground="#FFAAAAAA"/>
                                        <Slider Minimum="0" Maximum="255" Value="{Binding Value}" Orientation="Vertical"
                                                Height="140" HorizontalAlignment="Center" Margin="0,6"/>
                                        <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Cue list / Effects -->
        <Border Grid.Row="2" Background="#FF232323" Margin="8,0,8,8" Padding="4" BorderBrush="#FF3A3A3A" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabItem Header="Cues">
                    <Grid DataContext="{Binding CueListVm}" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Record form + transport -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="#" Width="50"/>
                                <TextBox Width="70" Text="{Binding NewCueNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Name" Width="50"/>
                                <TextBox Width="150" Text="{Binding NewCueName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Fade In" Width="50"/>
                                <TextBox Width="70" Text="{Binding NewFadeInSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Out" Width="30"/>
                                <TextBox Width="70" Text="{Binding NewFadeOutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Content="Record Cue (from Programmer)" Command="{Binding RecordCueCommand}" HorizontalAlignment="Left" Margin="0,4,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="◀ Back" Command="{Binding BackCommand}" FontSize="14"/>
                                <Button Content="GO" Command="{Binding GoCommand}" FontSize="14" FontWeight="Bold" Background="#FF2E7D32" Foreground="White" Width="60"/>
                                <Button Content="Stop" Command="{Binding StopCommand}" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding CurrentCueLabel, StringFormat='Active: {0}'}"/>
                            <ProgressBar Height="14" Margin="0,4,0,2" Minimum="0" Maximum="1" Value="{Binding TransitionProgress, Mode=OneWay}"/>
                            <TextBlock Text="{Binding RemainingTimeText}" FontSize="11" Foreground="#FFAAAAAA"/>
                        </StackPanel>

                        <!-- Cue table -->
                        <DataGrid Grid.Column="1" ItemsSource="{Binding CueList.Cues}" SelectedItem="{Binding SelectedCue}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  Background="#FF252525" Foreground="White" RowBackground="#FF252525" AlternatingRowBackground="#FF2C2C2C">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding GoToCueCommand}" CommandParameter="{Binding SelectedCue}"/>
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Fade In" Binding="{Binding FadeInTime}" Width="90"/>
                                <DataGridTextColumn Header="Fade Out" Binding="{Binding FadeOutTime}" Width="90"/>
                                <DataGridTemplateColumn Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveCueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Effects">
                    <Grid DataContext="{Binding EffectsVm}" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Target fixture picker -->
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="Target Fixtures" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableFixtures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- New effect form -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="New Effect" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Type" Width="65"/>
                                <ComboBox Width="150" ItemsSource="{Binding EffectTypeOptions}" SelectedItem="{Binding SelectedEffectType}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Name" Width="65"/>
                                <TextBox Width="150" Text="{Binding NewEffectName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Speed Hz" Width="65"/>
                                <TextBox Width="150" Text="{Binding SpeedHz, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Label Content="Spread" Width="65"/>
                                <TextBox Width="150" Text="{Binding Spread, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedEffectType, Converter={x:Static local:EffectTypeVisibilityConverter.Instance}, ConverterParameter='Chase,Strobe,Sine'}">
                                <Label Content="Channel" Width="65"/>
                                <ComboBox Width="150" ItemsSource="{Binding TargetChannelOptions}" SelectedItem="{Binding TargetChannel}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedEffectType, Converter={x:Static local:EffectTypeVisibilityConverter.Instance}, ConverterParameter='Chase,Strobe,Sine'}">
                                <Label Content="Min/Off" Width="65"/>
                                <TextBox Width="60" Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}"/>
                                <Label Content="Max/On" Width="60"/>
                                <TextBox Width="60" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedEffectType, Converter={x:Static local:EffectTypeVisibilityConverter.Instance}, ConverterParameter=Chase}">
                                <Label Content="Width" Width="65"/>
                                <TextBox Width="150" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedEffectType, Converter={x:Static local:EffectTypeVisibilityConverter.Instance}, ConverterParameter=Strobe}">
                                <Label Content="Duty" Width="65"/>
                                <TextBox Width="150" Text="{Binding DutyCycle, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedEffectType, Converter={x:Static local:EffectTypeVisibilityConverter.Instance}, ConverterParameter=Rainbow}">
                                <Label Content="Brightness" Width="65"/>
                                <TextBox Width="150" Text="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Content="Add Effect" Command="{Binding AddEffectCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" FontSize="11" Foreground="#FFAAAAAA" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Running effects -->
                        <DataGrid Grid.Column="2" ItemsSource="{Binding Effects}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" Background="#FF252525" Foreground="White" RowBackground="#FF252525" AlternatingRowBackground="#FF2C2C2C">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding EffectType}" Width="65" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Speed Hz" Binding="{Binding SpeedHz}" Width="70"/>
                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="40"/>
                                <DataGridTemplateColumn Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.RemoveEffectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#FF2A2A2A" Padding="6">
            <TextBlock Text="{Binding StatusMessage}"/>
        </Border>
    </Grid>
</Window>
